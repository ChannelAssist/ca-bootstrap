# ca-bootstrap state — written at runtime, never committed
.ca-bootstrap/
*.log

# Editor / OS
.DS_Store
.vscode/
.idea/

# Claude Code per-developer state (team-shared config under .claude/ stays tracked:
# settings.json, agents/, commands/, hooks/ — only the per-dev files are ignored)
.claude/settings.local.json
.claude/.credentials.json
.claude/scheduled_tasks*.lock
.claude/.cache/

# PowerShell module artifacts
*.psproj
*.psd1.bak

# Pester output
TestResults.xml
testResults.xml
coverage.xml

# Wiki working tree (separate git repo, never committed to main)
wiki/

# Accidental cwd-relative workspace from a misanswered smoke run
/y/
/n/

# Python (cab-tui)
cab-tui/.venv/
cab-tui/**/__pycache__/
cab-tui/**/*.egg-info/
cab-tui/.pytest_cache/
cab-tui/dist/
cab-tui/build/
